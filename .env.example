APP_NAME="Mail Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail-admin.yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL database created in cPanel
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_mailpanel
DB_USERNAME=cpaneluser_mailpanel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Used for welcome emails (client settings only, never passwords)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=panel@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=panel@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# cPanel API. The token stays in this file only (permissions 600, outside the web root).
CPANEL_HOST=server.yourhost.com
CPANEL_PORT=2083
CPANEL_USER=
CPANEL_TOKEN=
CPANEL_VERIFY_SSL=true
CPANEL_TIMEOUT=30
CPANEL_WEBMAIL_URL=https://{host}:2096

# Google sign-in (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Optional, Google Workspace only: refuse accounts outside your domain
GOOGLE_ALLOWED_DOMAIN=

# Limits
PANEL_MAX_QUOTA_MB=20480
PANEL_CSV_MAX_ROWS=500
PANEL_CSV_MAX_KB=512
# Rows processed per cron run; lower it if your host limits CPU time
PANEL_BULK_PER_RUN=40

# Security
# Roles that must use an authenticator app or passkey (comma separated; empty = nobody)
PANEL_2FA_REQUIRED_ROLES=super_admin
# Minutes a confirmation stays valid for sensitive changes (0 = off)
PANEL_STEP_UP_MINUTES=10
# Maximum age of a sign-in, in minutes, however active the person is
PANEL_SESSION_ABSOLUTE_MINUTES=720
# Changes one person may make per minute
PANEL_WRITES_PER_MINUTE=60
# Email alerts to super admins for risky events (needs working MAIL_ settings)
PANEL_SECURITY_ALERTS=true
# Removing a domain or a super admin needs a second super admin to approve (when two or more exist)
PANEL_FOUR_EYES=true
# Contact published at /.well-known/security.txt, for example mailto:security@yourdomain.com (empty = not published)
PANEL_SECURITY_CONTACT=
# Date the cPanel API token was created, YYYY-MM-DD; the dashboard warns when it gets old
CPANEL_TOKEN_CREATED=
